# Application
APP_NAME=PlanLuhh
APP_ENV=development
SECRET_KEY=your-super-secret-key-min-32-chars-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql://planluhh_user:planluhh_pass@localhost:5432/planluhh_db

# Email (FastAPI-Mail / SMTP)
MAIL_USERNAME=your@email.com
MAIL_PASSWORD=your-email-password
MAIL_FROM=noreply@planluhh.com
MAIL_FROM_NAME=PlanLuhh
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=True
MAIL_SSL_TLS=False

# Frontend URL (for CORS + email links)
FRONTEND_URL=http://localhost:5173

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Encryption (for financial data) - generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-encryption-key-here

# OTP
OTP_EXPIRE_MINUTES=10
